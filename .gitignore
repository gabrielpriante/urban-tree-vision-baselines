# Python bytecode and cache directories.
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments.
.venv/
venv/
env/

# Python packaging artifacts.
build/
dist/
*.egg-info/

# Test and coverage artifacts.
.pytest_cache/
.coverage
htmlcov/

# Jupyter notebook checkpoints.
.ipynb_checkpoints/

# Local environment and secret files.
.env
.env.*
!.env.example

# IDE-specific settings.
.vscode/
.idea/

# Operating system metadata.
.DS_Store
Thumbs.db
desktop.ini

# Local model caches and downloaded model weights.
models/
checkpoints/
.cache/

# Raw imagery is stored locally and is not committed to Git.
data/raw/

# Derived data products are generated locally and are not committed by default.
data/derived/

# Generated experiment outputs are not committed by default.
outputs/*

# Preserve the documentation file explaining the outputs directory.
!outputs/README.md

# Temporary files.
*.tmp
*.temp

# Ignore automatic PyTorch Lightning logs created during model execution.
lightning_logs/